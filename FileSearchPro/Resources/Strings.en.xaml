<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- MainWindow -->
    <s:String x:Key="AppTitle">FileSearchPro - Network File Search</s:String>
    <s:String x:Key="Scanned">Scanned:</s:String>
    <s:String x:Key="Found">Found:</s:String>
    <s:String x:Key="Ready">Ready</s:String>
    <s:String x:Key="IPAddress">IP addresses:</s:String>
    <s:String x:Key="IPHint">192.168.1.1-254  or  10.0.0.1,10.0.0.2</s:String>
    <s:String x:Key="StartSearch">Start search</s:String>
    <s:String x:Key="StopSearch">Stop</s:String>
    <s:String x:Key="Settings">Settings</s:String>
    <s:String x:Key="SearchResults">Search results</s:String>
    <s:String x:Key="ColShare">Share</s:String>
    <s:String x:Key="ColFullPath">Full path</s:String>
    <s:String x:Key="ColSize">Size</s:String>
    <s:String x:Key="ColModified">Modified</s:String>
    <s:String x:Key="Preview">Preview:</s:String>
    <s:String x:Key="ThreadInfo">Threads: {0} | Memory: {1}MB</s:String>
    <s:String x:Key="ScanLog">Scan log</s:String>
    <s:String x:Key="EntriesCount">{0} entries</s:String>
    <s:String x:Key="ClearLog">Clear</s:String>
    <s:String x:Key="CopyLog">Copy</s:String>
    <s:String x:Key="ExportLog">Export .log</s:String>
    <s:String x:Key="ColTime">Time</s:String>
    <s:String x:Key="ColStatus">Status</s:String>
    <s:String x:Key="ColMessage">Message</s:String>
    <s:String x:Key="ReadyToSearch">Ready to search</s:String>
    <s:String x:Key="Language">Language</s:String>

    <!-- SettingsWindow -->
    <s:String x:Key="SettingsTitle">Search settings</s:String>
    <s:String x:Key="Shares">Shares</s:String>
    <s:String x:Key="AllShares">All</s:String>
    <s:String x:Key="SearchAllShares">Search all discovered shares</s:String>
    <s:String x:Key="SearchAllSharesHint">Automatically find and search all disk shares (C$, D$, Users, etc.)</s:String>
    <s:String x:Key="Timeouts">Timeouts (increase for slow networks)</s:String>
    <s:String x:Key="PingTimeoutDesc">Wait time for host ping response</s:String>
    <s:String x:Key="ShareTimeoutDesc">Wait time for network share availability check</s:String>
    <s:String x:Key="FileTimeoutDesc">Wait time for file listing on share</s:String>
    <s:String x:Key="TimeoutHint">Recommended: 300/3000/5000 for fast networks, 500/5000/10000 for slow</s:String>
    <s:String x:Key="FileSearch">File search</s:String>
    <s:String x:Key="NamePattern">Name pattern:</s:String>
    <s:String x:Key="NamePatternHint">*.pdf  report_*.*  config.json</s:String>
    <s:String x:Key="Filters">Filters</s:String>
    <s:String x:Key="SizeKB">Size (KB):</s:String>
    <s:String x:Key="From">from:</s:String>
    <s:String x:Key="To">to:</s:String>
    <s:String x:Key="ModifiedDate">Modified date:</s:String>
    <s:String x:Key="ContentSearch">Content search</s:String>
    <s:String x:Key="SearchTextInFiles">Search text in files</s:String>
    <s:String x:Key="SearchTextHint">Search text (comma separated):</s:String>
    <s:String x:Key="SearchTextExample">Search: password, secret, error</s:String>
    <s:String x:Key="SearchInExtensions">Search in extensions:</s:String>
    <s:String x:Key="ExcludeExtensions">Exclude extensions:</s:String>
    <s:String x:Key="IncludeNoExt">Include files without extension</s:String>
    <s:String x:Key="Auth">Authentication</s:String>
    <s:String x:Key="CurrentUser">Current user</s:String>
    <s:String x:Key="CustomCredentials">Specify credentials</s:String>
    <s:String x:Key="Domain">Domain:</s:String>
    <s:String x:Key="Username">Username:</s:String>
    <s:String x:Key="Password">Password:</s:String>
    <s:String x:Key="Exclusions">Exclusions</s:String>
    <s:String x:Key="Folder">Folder</s:String>
    <s:String x:Key="File">File</s:String>
    <s:String x:Key="Save">Save</s:String>
    <s:String x:Key="Cancel">Cancel</s:String>

    <!-- Messages -->
    <s:String x:Key="MsgEnterIP">Enter IP addresses or range.</s:String>
    <s:String x:Key="MsgError">Error</s:String>
    <s:String x:Key="PreviewUnavailable">Preview unavailable for {0}</s:String>
    <s:String x:Key="Loading">Loading...</s:String>
    <s:String x:Key="PreviewTruncated">\n\n... (truncated, showing 50KB of {0}KB)</s:String>
    <s:String x:Key="PreviewReadError">Error reading file</s:String>
    <s:String x:Key="ScanningIP">Scanning: {0}</s:String>
    <s:String x:Key="ConnectingHosts">Connecting to hosts...</s:String>
    <s:String x:Key="Searching">Searching...</s:String>
    <s:String x:Key="ScanningAddresses">Scanning {0} addresses...</s:String>
    <s:String x:Key="ScanStarted">Scan started for {0} addresses</s:String>
    <s:String x:Key="ScanComplete">Scan complete. Online: {0}, offline: {1}</s:String>
    <s:String x:Key="FoundHostsSearching">Found {0} hosts. Searching files...</s:String>
    <s:String x:Key="Finished">Finished</s:String>
    <s:String x:Key="ReadyFoundFiles">Done. Files found: {0}</s:String>
    <s:String x:Key="SearchCompleteFound">Search complete. Files found: {0}</s:String>
    <s:String x:Key="SearchCancelled">Search cancelled</s:String>
    <s:String x:Key="MsgErrorPrefix">Error: {0}</s:String>
    <s:String x:Key="SearchError">Search error</s:String>
    <s:String x:Key="MsgErrorTitle">Error</s:String>
    <s:String x:Key="PreviewFiltered">Showing lines containing "{0}" ({1} of {2} lines)</s:String>
    <s:String x:Key="PreviewNoMatches">No lines found containing "{0}"</s:String>

    <!-- Log messages -->
    <s:String x:Key="LogSettings">Settings: ping={0}ms, shares={1}ms, files={2}ms</s:String>
    <s:String x:Key="AuthCurrentUser">current user</s:String>
    <s:String x:Key="LogAuth">Auth: {0}</s:String>
    <s:String x:Key="LogNetworkSummary">Network: {0:F1}min | Online: {1} | Offline: {2}</s:String>
    <s:String x:Key="LogTotalSummary">Total: {0:F1}min | Files: {1}</s:String>
    <s:String x:Key="LogScanningFiles">Scanning files on {0}...</s:String>
    <s:String x:Key="LogAvailableShares">Available shares: [{0}], searching: [{1}]</s:String>
    <s:String x:Key="LogNoShares">No available shares for search on {0}</s:String>
    <s:String x:Key="LogFromCache">(cached) {0}ms — {1}</s:String>
    <s:String x:Key="LogPingPort">Ping: {0}ms, port 445: {1}ms — {2}</s:String>
    <s:String x:Key="LogPingBlockedPort445">Ping: {0}ms (blocked), port 445: {1}ms — OK</s:String>
    <s:String x:Key="LogSharesSummary">Ping: {0}ms, port 445: {1}ms, shares: {2}ms — {3}</s:String>
    <s:String x:Key="LogPortClosed445">port 445 closed</s:String>
</ResourceDictionary>
