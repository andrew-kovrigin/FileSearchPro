    <s:String x:Key="Password">Пароль:</s:String>
    <s:String x:Key="Exclusions">Исключения</s:String>
    <s:String x:Key="Folder">Папка</s:String>
    <s:String x:Key="File">Файл</s:String>
    <s:String x:Key="Save">Сохранить</s:String>
    <s:String x:Key="Cancel">Отмена</s:String>

