    <s:String x:Key="Loading">Загрузка...</s:String>
    <s:String x:Key="PreviewTruncated">\n\n... (обрезано, показано 50КБ из {0}КБ)</s:String>
    <s:String x:Key="PreviewReadError">Ошибка чтения файла</s:String>
    <s:String x:Key="ScanningIP">Сканирование: {0}</s:String>
    <s:String x:Key="ConnectingHosts">Подключение к хостам...</s:String>
    <s:String x:Key="Searching">Поиск...</s:String>
    <s:String x:Key="ScanningAddresses">Сканирование {0} адресов...</s:String>
    <s:String x:Key="ScanStarted">Начато сканирование {0} адресов</s:String>
    <s:String x:Key="ScanComplete">Сканирование завершено. Онлайн: {0}, оффлайн: {1}</s:String>
    <s:String x:Key="FoundHostsSearching">Найдено {0} хостов. Поиск файлов...</s:String>
    <s:String x:Key="Finished">Завершено</s:String>
    <s:String x:Key="ReadyFoundFiles">Готов. Найдено файлов: {0}</s:String>
    <s:String x:Key="SearchCompleteFound">Поиск завершён. Найдено файлов: {0}</s:String>
    <s:String x:Key="SearchCancelled">Поиск отменён</s:String>
