<Window x:Class="FileSearchPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileSearchPro.ViewModels"
        Title="{DynamicResource AppTitle}"
        Height="800" Width="1300"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Status Bar -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Scanned}" Foreground="#AAA" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ScannedCountText}" Foreground="#4EC9B0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,16,0"/>
                    <TextBlock Text="{DynamicResource Found}" Foreground="#AAA" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FoundCountText}" Foreground="#569CD6" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Control Strip -->
        <Border Grid.Row="1" Background="#252526" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource IPAddress}" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding IpRange, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="{DynamicResource IPHint}" Foreground="#666" FontSize="11"
                           Grid.Column="1" VerticalAlignment="Center" Margin="0,22,0,0"/>
                <Button Content="{DynamicResource StartSearch}" Grid.Column="2" Command="{Binding StartSearchCommand}"
                        Margin="0,0,8,0" Padding="16,6"/>
                <Button Content="{DynamicResource StopSearch}" Grid.Column="3" Command="{Binding StopSearchCommand}"
                        Background="#CC3333" IsEnabled="{Binding IsStopEnabled}" Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource Settings}" Grid.Column="4" Command="{Binding OpenSettingsCommand}"
                        Padding="16,6"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="250"/>
            </Grid.RowDefinitions>

            <!-- Results Panel -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="100"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource SearchResults}" FontSize="14" FontWeight="Bold" Foreground="#D4D4D4" Margin="0,0,0,6"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{DynamicResource ColShare}" Binding="{Binding Share}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{DynamicResource ColFullPath}" Binding="{Binding FullPath}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{DynamicResource ColSize}" Binding="{Binding SizeFormatted}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{DynamicResource ColModified}" Binding="{Binding LastModified, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="120" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#3F3F46" Cursor="SizeNS"/>

                <Border Grid.Row="3" Background="#252526" CornerRadius="3">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4">
                            <TextBlock Text="{DynamicResource Preview}" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PreviewFileName}" Foreground="#007ACC" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewTextBlock" Background="Transparent" Foreground="#D4D4D4"
                                       Text="{Binding PreviewText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="8,0"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#3F3F46" Cursor="SizeNS"/>

            <!-- Scan Log Panel -->
            <Border Grid.Row="2" Background="#252526" CornerRadius="3">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4">
                        <TextBlock Text="{DynamicResource ScanLog}" FontSize="13" FontWeight="Bold"
                                   Foreground="#D4D4D4" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LogCountText}" Foreground="#888"
                                   FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Button Content="{DynamicResource CopyLog}" Command="{Binding CopyLogCommand}"
                                Margin="12,0,0,0" Padding="8,2" FontSize="11"/>
                        <Button Content="{DynamicResource ExportLog}" Command="{Binding ExportLogCommand}"
                                Margin="4,0,0,0" Padding="8,2" FontSize="11"/>
                        <Button Content="{DynamicResource ClearLog}" Command="{Binding ClearLogCommand}"
                                Margin="4,0,0,0" Padding="8,2" FontSize="11"/>
                    </StackPanel>
                    <ListView x:Name="LogListView" Background="Transparent" BorderThickness="0"
                              ItemsSource="{Binding LogEntries}"
                              Foreground="#D4D4D4" VirtualizingStackPanel.IsVirtualizing="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource ColTime}" Width="80"
                                    DisplayMemberBinding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"/>
                                <GridViewColumn Header="IP" Width="120"
                                    DisplayMemberBinding="{Binding IpAddress}"/>
                                <GridViewColumn Header="{DynamicResource ColStatus}" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding Status, Converter={StaticResource ScanStatusToBrushConverter}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource ColMessage}" DisplayMemberBinding="{Binding Message}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="#007ACC" CornerRadius="3" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentFileText}" Foreground="White" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ThreadCountText}" Foreground="#B0D4FF" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ProgressBar Grid.Column="2" Width="100" Height="14" IsIndeterminate="True"
                             Visibility="{Binding IsSearchProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
