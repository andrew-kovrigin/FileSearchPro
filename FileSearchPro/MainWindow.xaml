<Window x:Class="FileSearchPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileSearchPro - Поиск файлов в сети" 
        Height="800" Width="1300"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Status Bar -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Пройдено:" Foreground="#AAA" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScannedCountText" Text=" 0 " Foreground="#4EC9B0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,16,0"/>
                    <TextBlock Text="Найдено:" Foreground="#AAA" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FoundCountText" Text=" 0 " Foreground="#569CD6" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="2" Text="Готов" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Results Panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Результаты поиска" FontSize="14" FontWeight="Bold" Foreground="#D4D4D4" Margin="0,0,0,6"/>
                <DataGrid x:Name="ResultsGrid" Grid.Row="1" SelectionChanged="ResultsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="110"/>
                        <DataGridTextColumn Header="Шара" Binding="{Binding Share}" Width="60"/>
                        <DataGridTextColumn Header="Полный путь" Binding="{Binding FullPath}" Width="*"/>
                        <DataGridTextColumn Header="Размер" Binding="{Binding SizeFormatted}" Width="80"/>
                        <DataGridTextColumn Header="Изменён" Binding="{Binding LastModified, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#3F3F46" Cursor="SizeNS"/>

                <Border Grid.Row="3" Background="#252526" CornerRadius="3">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4">
                            <TextBlock Text="Предпросмотр:" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PreviewFileName" Text="" Foreground="#007ACC" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer x:Name="PreviewScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewTextBlock" Background="Transparent" Foreground="#D4D4D4"
                                       TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="8,0"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#3F3F46"/>

            <!-- Settings Panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Настройки поиска" FontSize="14" FontWeight="Bold" Foreground="#D4D4D4" Margin="0,0,0,10"/>

                    <!-- IP Range -->
                    <GroupBox Header="Сетевые адреса" Margin="0,0,0,8">
                        <StackPanel Margin="4">
                            <TextBlock Text="IP-адреса:" Foreground="#AAA" Margin="0,0,0,4"/>
                            <TextBox x:Name="IpRangeBox" Text="" Margin="0,0,0,4"/>
                            <TextBlock Text="192.168.1.1-254  или  10.0.0.1,10.0.0.2" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Shares -->
                    <GroupBox Header="Шары" Margin="0,0,0,8">
                        <StackPanel Margin="4">
                            <WrapPanel>
                                <CheckBox x:Name="ChkShareC" Content="C$" IsChecked="True" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkShareD" Content="D$" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkUsers" Content="Users" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkAll" Content="Все"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Workers -->
                    <GroupBox Header="Производительность" Margin="0,0,0,8">
                        <StackPanel Margin="4">
                            <TextBlock Text="Потоков одновременно:" Foreground="#AAA" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <Slider x:Name="WorkersSlider" Width="200" Minimum="1" Maximum="512" Value="128"
                                        TickFrequency="16" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WorkersCountText" Text="128" Foreground="#4EC9B0" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
                            </WrapPanel>
                            <TextBlock Text="Windows 11: до 512 потоков для сетевого I/O" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- File Pattern -->
                    <GroupBox Header="Поиск файла" Margin="0,0,0,8">
                        <StackPanel Margin="4">
                            <TextBlock Text="Шаблон имени:" Foreground="#AAA" Margin="0,0,0,4"/>
                            <TextBox x:Name="FilePatternBox" Text="*.*" Margin="0,0,0,4"/>
                            <TextBlock Text="*.pdf  report_*.*  config.json" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Filters -->
                    <GroupBox Header="Фильтры" Margin="0,0,0,8">
                        <StackPanel Margin="4">
                            <TextBlock Text="Размер (КБ):" Foreground="#AAA" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="от:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="MinSizeBox" Width="80" Margin="0,0,12,0"/>
                                <TextBlock Text="до:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="MaxSizeBox" Width="80"/>
                            </WrapPanel>
                            <TextBlock Text="Дата модификации:" Foreground="#AAA" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <TextBlock Text="от:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker x:Name="DateFromPicker" Width="130" Margin="0,0,10,0"/>
                                <TextBlock Text="до:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker x:Name="DateToPicker" Width="130"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Content Search -->
                    <GroupBox Header="Поиск по содержимому" Margin="0,0,0,8">
                        <StackPanel Margin="4">
                            <CheckBox x:Name="ChkSearchContent" Content="Искать текст в файлах" Margin="0,0,0,6"/>
                            <TextBlock Text="Текст для поиска (через запятую):" Foreground="#AAA" Margin="0,0,0,4"/>
                            <TextBox x:Name="ContentSearchBox" Margin="0,0,0,4"/>
                            <TextBlock Text="Искать: password, ключ, error" Foreground="#666" FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock Text="Искать в расширениях:" Foreground="#AAA" Margin="0,0,0,4"/>
                            <TextBox x:Name="ContentExtensionsBox" Text=".txt,.log,.csv,.xml,.json,.cs,.py,.js,.md,.cfg,.ini" Margin="0,0,0,4"/>
                            <TextBlock Text="Исключить расширения:" Foreground="#AAA" Margin="0,0,0,4"/>
                            <TextBox x:Name="ContentExcludeExtensionsBox" Text=".exe,.dll,.bin,.zip,.rar,.7z,.png,.jpg,.gif" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkIncludeNoExt" Content="Включить файлы без расширения" IsChecked="True" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Authentication -->
                    <GroupBox Header="Авторизация" Margin="0,0,0,8">
                        <StackPanel Margin="4">
                            <RadioButton x:Name="RbCurrentUser" Content="Текущий пользователь" IsChecked="True" Margin="0,0,0,6"
                                         Checked="RbCurrentUser_Checked"/>
                            <RadioButton x:Name="RbCustom" Content="Указать учётные данные" Margin="0,0,0,6"
                                         Checked="RbCustom_Checked"/>
                            <StackPanel x:Name="CustomCredsPanel" IsEnabled="False" Margin="16,0,0,0">
                                <TextBlock Text="Домен:" Foreground="#AAA" Margin="0,0,0,2"/>
                                <TextBox x:Name="DomainBox" Margin="0,0,0,4"/>
                                <TextBlock Text="Пользователь:" Foreground="#AAA" Margin="0,0,0,2"/>
                                <TextBox x:Name="UsernameBox" Margin="0,0,0,4"/>
                                <TextBlock Text="Пароль:" Foreground="#AAA" Margin="0,0,0,2"/>
                                <PasswordBox x:Name="PasswordBox"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Exclusions -->
                    <GroupBox Header="Исключения" Margin="0,0,0,8">
                        <StackPanel Margin="4">
                            <ListBox x:Name="ExclusionsList" Height="100" Background="#333337" Foreground="#D4D4D4"
                                     BorderBrush="#3F3F46"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBox x:Name="NewExclusionBox" Width="160" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ExclusionTypeCombo" Width="70" Margin="0,0,6,0">
                                    <ComboBoxItem Content="Папка" IsSelected="True"/>
                                    <ComboBoxItem Content="Файл"/>
                                </ComboBox>
                                <Button Content="+" Width="28" Click="AddExclusion_Click"/>
                                <Button Content="-" Width="28" Margin="4,0,0,0" Click="RemoveExclusion_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Action Buttons -->
                    <WrapPanel Margin="0,4,0,0">
                        <Button x:Name="BtnStart" Content="Начать поиск" Click="StartSearch_Click" Margin="0,0,8,0" Padding="20,8"/>
                        <Button x:Name="BtnStop" Content="Остановить" Click="StopSearch_Click" Background="#CC3333" IsEnabled="False" Padding="20,8"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" CornerRadius="3" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentFileText" Grid.Column="0" Text="Готов к поиску" Foreground="White" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ProgressBar x:Name="SearchProgress" Grid.Column="1" Width="100" Height="14" IsIndeterminate="True" Visibility="Collapsed"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
